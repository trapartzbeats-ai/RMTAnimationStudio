{
  "name": "rmt-animation-studio",
  "productName": "RMT Animation Studio",
  "version": "2.0.0",
  "description": "RMT Animation Studio: poses, effects, review and setup for City Breaker / BSP Universe clips in one app (Electron + three.js), with an agent API for MCP.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest --hidden",
    "dist": "electron-builder --win nsis --x64"
  },
  "author": "RMT (Ro Made That)",
  "license": "MIT",
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "build": {
    "appId": "com.rmt.animationstudio",
    "productName": "RMT Animation Studio",
    "copyright": "RMT (Ro Made That)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "tests/**/*",
      "!node_modules/three/src/**/*",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RMT Animation Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "artifactName": "RMTAnimationStudio-Setup-${version}.exe",
      "uninstallDisplayName": "RMT Animation Studio"
    }
  }
}
